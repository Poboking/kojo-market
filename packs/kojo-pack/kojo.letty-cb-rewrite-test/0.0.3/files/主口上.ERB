LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 远处突然有声音传来、伴随着十足的冷气。（此为测试文本）
	PRINTFORMW %CALLNAME:MASTER%看向声音传来的方向、有一个妖怪呼呼地飞了过来。（此为测试文本）
	PRINTFORML
	PRINTFORML 「呐呐呐、你是谁呀？（此为测试文本）」
	PRINTFORMW 那妖怪有着像下雪时的阴天一样的淡藤色头发。衣服是蓝色与白色的搭配、帽子和围巾则是纯白色的、像是深雪的颜色。（此为测试文本）
	PRINTFORMW 她在%CALLNAME:MASTER%的面前飘然降落下来。少女看上去十分端庄成熟、个子也很高。（此为测试文本）
	PRINTFORML 「我叫蕾蒂·霍瓦特洛克。是喜欢冬天的妖怪（此为测试文本）」
	PRINTFORMW 自我介绍完毕之后、她莞尔一笑。那是与成熟的外表相反的、和蔼可亲的笑容。（此为测试文本）
	PRINTFORML 「想和我搞好关系的话、先从往日的问候开始吧（此为测试文本）」
	PRINTFORML 「也请将你的名字告诉我♪（此为测试文本）」
	PRINTFORMW 在细雪飞舞的氛围中、蕾蒂用春天般的声音询问着%CALLNAME:MASTER%。（此为测试文本）
	PRINTFORML
	PRINTFORML 「%CALLNAME:MASTER%啊！呵呵、以后要好好相处哦♪（此为测试文本）」
	PRINTFORMW 人不可貌相、一开始还以为会是个言行举止轻浮的妖怪。（此为测试文本）
	PRINTFORML 据说雪女会用美丽的外表引诱人类、然后将其冻死。（此为测试文本）
	PRINTFORMW 但%CALLNAME:MASTER%从她身上感受不到那种恶毒。（此为测试文本）
	SIF FIRSTTIME("开局设定",0,74)
		CALL KOJO_CB風_OPTION_K74_RESULT_1
	RETURN 1
ENDIF
RETURN 1

