;made it as a way to speed up the update process and separate simple flag updates from various customization options

@KOJO_CB風_OPTION_EXIST_K74
#LOCALSIZE 1
#LOCALSSIZE 1
;note: options start from 1!

@KOJO_CB風_OPTION_K74
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = TARGET
TARGET = 74
CALL SET_KOJO_COLOR
CALL KOJO_OPTION_ITEM(@"剧本推荐的开局设定", 1, "onetime", !FIRSTTIME("开局设定",1,74), "status:未采纳:采纳", CFLAG:74:1001)
TARGET = LOCAL
RESETCOLOR
;process the input portion

@KOJO_CB風_OPTION_K74_RESULT_1
#LOCALSIZE 1
#LOCALSSIZE 1
PRINTFORML 要根据推荐，将蕾蒂设定为符合该剧本的人设吗？
PRINTFORML 如果允许，V经验和V感觉将变为0，并获得【无知】。
PRINTFORML 如果不允许，请注意可能会与文本内容产生龃龉。
PRINTFORML 
CALL ASK_YN("允许","不允许")
SELECTCASE RESULT
;如果允许
CASE 0
	CFLAG:74:1001 = 1
	PRINTFORMW 蕾蒂变成对性一无所知的清楚系御姐了
	TALENT:74:処女 = 1
	CSTR:74:46 = 还没被任何人进入
	TALENT:74:無知 = 1
	EXP:74:Ｖ経験 = 0
	ABL:74:Ｖ感覚 = 0
	CFLAG:74:処女喪失記念日 = 0
;如果不允许
CASE 1
	CFLAG:74:1001 = 0
	PRINTFORMW 未更改
ENDSELECT
CALLF FIRSTTIME("开局设定",0,74)

;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"ENCOUNTER"系イベント（エクストラ構文）
;※※※※※※※※※※※※※※※※※※※※※※※※※※

@M_KOJO_CB風_EVENT_K74_2(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------

IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;非同棲かつ相手が先に起きてる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;TARGET私室にMASTERが入っている（恋慕時陪睡中就寝時のみ？
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;MASTER私室にTARGETが入ってきてる(恋慕無しでも入ってくる可能性有り
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMW 
			RETURN 1
		ENDIF
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が起きている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同棲かつ相手が寝ている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが起きていて、相手が起きてきた
	;添い寝時TARGET起床はこちら（TARGET衰弱or陪睡中TARGET睡魔負け後そのままMASTERが起き続けた上で相手が起床した場合限定
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;-------------------------------------------------
		;非同棲
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMW 
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;同棲中
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMW 
			RETURN 1
		ENDIF
		PRINTFORMW 
		RETURN 1
	ENDIF
	;其他
	PRINTFORML  
ENDIF
RETURN 1

