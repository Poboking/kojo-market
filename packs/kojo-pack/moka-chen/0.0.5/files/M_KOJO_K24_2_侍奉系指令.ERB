;※※※※※※※※※※※※※※※※※※※※※※※※※
;侍奉系指令
;※※※※※※※※※※※※※※※※※※※※※※※※※
;-------------------------------------------------
;总览
;-------------------------------------------------
;维护人：狂气刘俊海
;维护日期：2026年4月29日

;编号80~85号、88号的侍奉系指令
;*均为诶嘿嘿中指令

;如果不知道指令的含义，或不知道如何设计差分，金标准是参照该指令的情景描写文本。
;本系列的情景描写在EVENT_MESSAGE_COM80~.ERB

;侍奉系指令涉及角色使用身体部位为玩家提供性服务，包括手、口、胸、腿、足等。
;多为单向服务（角色服务玩家），因此核心差分围绕射精状态展开。
;84号泡泡浴较为特殊，通常在没有时奸判定的特殊场景中使用。

;==================================================
;基本陷落嵌套模板
;==================================================
	;恋慕
	IF TALENT:恋慕
		PRINTFORML 
		RETURN 1
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 
		RETURN 1
	;思慕
	ELSEIF TALENT:思慕
		PRINTFORML 
		RETURN 1
	;其他
	ELSE
		PRINTFORML 
		RETURN 1
	ENDIF
[SKIPEND]

;==================================================
;80,手淫
;==================================================
;说明：角色用手为玩家手淫。关键差分：时奸中、初次、射精时、通常陷落嵌套。
@M_KOJO_MOKA_MESSAGE_COM_K24_80
#LOCALSIZE 1
#LOCALSSIZE 1

;时奸中
IF FLAG:70
	PRINTFORML 
	RETURN 1
;初次
ELSEIF FIRSTTIME(SELECTCOM)
	PRINTFORML 
	RETURN 1
;本回合射精
ELSEIF NOWEX:11
	PRINTFORML 
	RETURN 1
;通常
ELSE
	;恋慕
	IF TALENT:恋慕
		PRINTFORML 
		RETURN 1
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 
		RETURN 1
	;思慕
	ELSEIF TALENT:思慕
		PRINTFORML 
		RETURN 1
	;其他
	ELSE
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF

RETURN 0

;==================================================
;81,口交
;==================================================
;说明：角色用嘴为玩家口交。关键差分：时奸中、初次、射精时、上回合被中出清理口交、通常陷落嵌套。
;清理口交分支：TCVAR:MASTER:112 == 1(V清理)/2(A清理)时，角色口交前清洁沾满精液的阴茎。
;拔出追加分支：TCVAR:MASTER:112 == 8时，角色先在体内射精后拔出再口交。
;具体分支可参考@MESSAGE_COM81中TCVAR:MASTER:112的各个取值处理。
@M_KOJO_MOKA_MESSAGE_COM_K24_81
#LOCALSIZE 1
#LOCALSSIZE 1

;时奸中
IF FLAG:70
	IF FIRSTTIME ("时停口交")
		PRINTFORMDL 在时间停止下、%CALLNAME:MASTER%凑近橙凝固着的小脸蛋、用手指捏住脸颊、轻轻地帮橙张开了小嘴
		PRINTFORMDW 伸出手指细细探索着眼前诱人的粉嫩口腔、第一个感受到的便是舌头上的奇妙触感
		PRINTFORMDW 只是手指触碰就已经感到微微刺痒、若是不做准备就把胯下的东西放进去的话、绝对不会有什么好事发生的...
		PRINTFORMDW ...但若只是因为可能的疼痛而放弃如此诱人的猫娘萝莉小嘴、那只能是弱者的思维！
		PRINTFORMDW 这样想着的%CALLNAME:MASTER%、在确认了已经把唾液完全涂满橙的嘴中后、便决然地将身下雄起的怒张顶在薄唇之上、小心翼翼地朝内探入着...
		PRINTFORMDW 随着突然发出的“啵”的一声、抵在唇尖的龟头前端便一下子滑进了小猫妖湿热的口腔之中、迅速传递而来的强烈刺激让%CALLNAME:MASTER%都下意识发出了一声呻吟
		PRINTFORMDW 停下动作稍稍恢复了镇定后、%CALLNAME:MASTER%才轻轻地按住身下静止着的那对毛茸茸的黑色猫耳、慢慢地来回移动起她的小脑袋、正式品尝起几乎将龟头完全吸住的紧致口穴... 
	ELSEIF ABL:24:4 >= 5 || ABL:24:51 >= 5 ;经验丰富的差分
	;原本是打算以陷落做为差分的...但时停做爱和普通的爱爱不一样、我就默认看见这里的为爱欲线了（
		PRINTFORMDW
		SELECTCASE RAND:3
		CASE 0
			PRINTFORMDW 
		CASE 1
			PRINTFORMDW 
		CASE 2
			PRINTFORMDW 
		ENDSELECT  
	ELSEIF ABL:24:4 >= 3 || ABL:24:51 >= 3 ;接近熟练的差分
		PRINTFORMDW
		SELECTCASE RAND:3
		CASE 0
			PRINTFORMDW 
		CASE 1
			PRINTFORMDW 
		CASE 2
			PRINTFORMDW 
		ENDSELECT
	ELSEIF ABL:24:4 >= 1 || ABL:24:51 >= 1 ;初步认识的差分
		PRINTFORMDW  
		SELECTCASE RAND:2
		CASE 0
			PRINTFORMDW 
		CASE 1
			PRINTFORMDW 
		ENDSELECT
	ELSE 
		PRINTFORMDW 
	ENDIF
	RETURN 1
;初次
ELSEIF FIRSTTIME(SELECTCOM)
	PRINTFORML 
	RETURN 1
;本回合射精
ELSEIF NOWEX:11
	PRINTFORML 
	RETURN 1
;上回合被中出，清理口交
ELSEIF TCVAR:MASTER:V被中出FLAG || TCVAR:MASTER:A被中出FLAG
	PRINTFORML 
	RETURN 1
;通常
ELSE
	;恋慕
	IF TALENT:恋慕
		PRINTFORML 
		RETURN 1
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 
		RETURN 1
	;思慕
	ELSEIF TALENT:思慕
		PRINTFORML 
		RETURN 1
	;其他
	ELSE
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF

RETURN 0

